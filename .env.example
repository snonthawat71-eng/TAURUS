# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase
# (Supabase Dashboard -> Project Settings -> API)

# URL ของโปรเจกต์ เช่น https://abcdxyz.supabase.co
VITE_SUPABASE_URL=

# anon public key (ตัวยาวๆ ขึ้นต้น eyJ...) — ปลอดภัยที่จะอยู่ฝั่งเว็บ
VITE_SUPABASE_ANON_KEY=

# (ไม่บังคับ) Cloudinary — ถ้าใส่ค่า 2 ตัวนี้ รูปภาพจะอัปขึ้น Cloudinary แทน Supabase Storage
# Cloudinary Dashboard -> Settings -> Upload -> สร้าง "Upload preset" แบบ Unsigned
# cloud name อยู่หน้า Dashboard, ส่วน preset คือชื่อ preset ที่สร้าง
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# (ไม่บังคับ) Web Push แจ้งเตือนเมื่อถึงเวลาตามแพลน — VAPID public key
# สร้างด้วย: npx web-push generate-vapid-keys  (เอา Public Key มาใส่ที่นี่,
# Private Key ไปตั้งเป็น secret ของ Edge Function — ดู supabase/PUSH_SETUP.md)
VITE_VAPID_PUBLIC_KEY=
